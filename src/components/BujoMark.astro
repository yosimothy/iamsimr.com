---
/*
  A couple of bullet-journal marks for the margins: a little task log and a
  starred, circled reminder. Faint, sparse, and never legible text.
  Use at most one or two per page.

  Usage: <BujoMark kind="log" style="top: 2rem; right: 0" />
  The parent element needs `position: relative`.
*/
interface Props { kind: 'log' | 'star'; size?: number; rot?: string; style?: string; }
const { kind, size = 120, rot = '0deg', style = '' } = Astro.props;
---
<svg class="bujo" style={`--rot:${rot}; ${style}`} width={size} height={size} viewBox="0 0 120 120" aria-hidden="true">
  {kind === 'log' && (
    <g>
      {/* ✓ done */}
      <rect x="10" y="18" width="11" height="11" rx="1.5" transform="rotate(-3 15 23)" />
      <path d="M12.5 23.5l2.6 3 5.4-7.5" stroke-width="1.6" />
      <path d="M30 25c10-2 22 1 34-1s18 1 26 0" />
      {/* × cancelled */}
      <path d="M11 47l9 9M20 47l-9 9" />
      <path d="M30 52c8-1 18 1 28 0" />
      <path d="M28 52.5h32" stroke-width="0.8" />
      {/* > migrated */}
      <path d="M11 74l8 5-8 5" />
      <path d="M30 80c12-2 24 1 36-1 6-1 10 0 14 0" />
      {/* • open */}
      <circle cx="15.5" cy="106" r="2.6" fill="currentColor" />
      <path d="M30 106c9-1 20 1 30-1" />
    </g>
  )}
  {kind === 'star' && (
    <g>
      <path d="M60 22c-22-1-42 13-43 36-1 25 20 41 45 40 24-1 42-18 41-40-1-20-17-34-38-35-8 0-15 2-20 5" />
      <path d="M60 42v34M45 51l30 16M75 51l-30 16" stroke-width="1.6" />
    </g>
  )}
</svg>
<style>
  .bujo {
    position: absolute; z-index: 0; pointer-events: none;
    color: var(--ink-2); opacity: 0.3;
    transform: rotate(var(--rot));
    fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round;
  }
  @media (max-width: 1000px) { .bujo { display: none; } }
</style>
