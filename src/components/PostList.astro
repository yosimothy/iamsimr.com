---
// Entries as a bullet-journal log: a marker dot (its colour says what kind
// of entry it is), the entry, and a handwritten date.
import type { Entry } from '../lib/posts';
interface Props { entries: Entry[]; }
const { entries } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const label = { note: 'note', yap: 'yap', project: 'project' } as const;
---
<ul class="log">
  {entries.map((e) => (
    <li>
      <a href={e.href}>
        <span class="bullet"><i class={`mdot k-${e.kind}`} aria-hidden="true"></i><span class="sr-only">{label[e.kind]}: </span></span>
        <span class="body">
          <span class="title">{e.title}{e.draft && <em class="draft"> draft</em>}</span>
          <span class="desc muted">{e.desc}</span>
          {e.tags.length > 0 && <span class="tags">{e.tags.map((t) => `#${t}`).join('  ')}</span>}
        </span>
        {e.date && <time class="hand" datetime={e.date.toISOString()}>{fmt(e.date)}</time>}
      </a>
    </li>
  ))}
</ul>
<style>
  .log { list-style: none; padding: 0; margin: 0; }
  li + li { border-top: 1.5px dashed var(--rule); }
  a { display: grid; grid-template-columns: 1.4rem 1fr auto; gap: 0 1rem; padding: 1.15rem 0; text-decoration: none; align-items: start; }
  .bullet { margin-top: 0.45rem; justify-self: center; }
  .bullet .mdot { width: 17px; height: 15px; transition: transform 0.2s ease; }
  a:hover .mdot { transform: scale(1.25) rotate(8deg); }
  a:hover .title { text-decoration: underline 3px var(--yellow); text-underline-offset: 4px; }
  a:hover { color: var(--ink); }
  .body { display: grid; gap: 0.15rem; }
  .title { font: 700 1.25rem/1.25 var(--display); letter-spacing: -0.015em; }
  .desc { font-size: 0.98rem; }
  .tags { font-size: 0.8rem; color: var(--ink-2); font-weight: 500; }
  time { color: var(--ink-2); font-size: 1.3rem; white-space: nowrap; padding-top: 0.1rem; }
  .draft { color: var(--red); font-family: var(--hand); font-size: 1.1rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 640px) {
    a { grid-template-columns: 1.4rem 1fr; }
    time { grid-column: 2; grid-row: 1; padding: 0 0 0.1rem; font-size: 1.15rem; }
    .body { grid-row: 2; grid-column: 2; }
    .bullet { grid-row: 1 / span 2; }
  }
</style>
