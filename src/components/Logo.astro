---
// Wordmark: "iamsimr" (I am Sim R). The two i's get marker-coloured dots.
// `variant` "split" sets "iam" lighter so "simr" reads first.
interface Props { size?: string; variant?: 'solid' | 'split'; }
const { size = '1.65rem', variant = 'split' } = Astro.props;
---
<span class={`wordmark ${variant}`} style={`--wm:${size}`} aria-label="iamsimr" role="img">
  <span class="iam" aria-hidden="true"><span class="i">ı<i class="dot red"></i></span>am</span><span class="simr" aria-hidden="true">s<span class="i">ı<i class="dot blue"></i></span>mr</span>
</span>
<style>
  .wordmark { display: inline-flex; align-items: baseline; font: 800 var(--wm)/1 var(--display); letter-spacing: -0.035em; color: var(--ink); white-space: nowrap; }
  .split .iam { font-weight: 450; color: var(--ink-2); letter-spacing: -0.02em; }
  .i { position: relative; display: inline-block; }
  /* The tittle: a round marker dot sitting where the i's dot would be. */
  .dot { position: absolute; left: 50%; top: 0.025em; width: 0.25em; height: 0.25em; margin-left: -0.125em; border-radius: 50%; transition: transform 0.35s cubic-bezier(.3,1.7,.5,1); }
  .split .iam .dot { width: 0.21em; height: 0.21em; margin-left: -0.105em; top: 0.05em; }
  .red { background: var(--red); }
  .blue { background: var(--blue); }
  :global(a:hover) > .wordmark .dot, :global(button:hover) > .wordmark .dot { transform: translateY(-0.12em); }
  :global(a:hover) > .wordmark .blue, :global(button:hover) > .wordmark .blue { transition-delay: 0.06s; }
</style>
