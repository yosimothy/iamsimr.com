---
// Site mark: three overlapping marker dots.
interface Props { size?: number; }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo-mark">
  <g class="blend">
    <circle cx="13" cy="14" r="10" fill="var(--blue)" />
    <circle cx="21" cy="12" r="7.5" fill="var(--yellow)" opacity="0.9" />
    <circle cx="20" cy="23" r="5.5" fill="var(--red)" opacity="0.9" />
  </g>
</svg>
<style>
  .blend { mix-blend-mode: multiply; }
  @media (prefers-color-scheme: dark) { .blend { mix-blend-mode: normal; } }
</style>
