---
// Wordmark: "iam · sim · r" in Outfit. "sim" is bold so the name reads on its
// own; the i's are dotless and get hand-dabbed marker dots, red and blue.
import '@fontsource-variable/outfit';
interface Props { size?: string; }
const { size = '1.7rem' } = Astro.props;
---
<span class="wordmark" style={`--wm:${size}`} role="img" aria-label="iamsimr">
  <span class="l" aria-hidden="true"><span class="i">ı<svg class="dab red" viewBox="0 0 20 20"><path d="M2.2 11.8C1.6 8.6 4.4 6.1 8.6 5.5c3.6-.5 7.9-.1 9.1 2.6 1 2.4-.9 5.2-4.6 6.5-2.4.8-4.6.6-6.6.9-2.2.3-4-1.3-4.3-3.7z" /></svg></span>am</span><span class="b" aria-hidden="true">s<span class="i">ı<svg class="dab blue" viewBox="0 0 20 20"><path d="M1.9 10.9c-.3-2.8 2.3-5.4 6.2-6.1 2.9-.5 5.4.4 7.4 1.2 2.2.9 3.1 2.9 2 4.9-1.3 2.4-4.8 3.9-8.3 3.9-3.6 0-7-1.3-7.3-3.9z" /></svg></span>m</span><span class="l" aria-hidden="true">r</span>
</span>
<style>
  .wordmark { display: inline-flex; align-items: baseline; font: 400 var(--wm)/1 'Outfit Variable', var(--display); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; }
  .l { font-weight: 300; color: var(--ink-2); }
  .b { font-weight: 700; }
  .i { position: relative; display: inline-block; }
  /* Hand-dabbed tittles: slightly lopsided, tilted, never perfectly round. */
  .dab { position: absolute; left: 50%; overflow: visible; transition: transform 0.35s cubic-bezier(.3,1.7,.5,1); }
  .dab path { fill: currentColor; }
  .red { color: var(--red); width: 0.27em; height: 0.27em; top: 0.07em; margin-left: -0.095em; transform: rotate(-22deg); }
  .blue { color: var(--blue); width: 0.31em; height: 0.31em; top: 0.03em; margin-left: -0.15em; transform: rotate(14deg); }
  :global(a:hover) > .wordmark .red, :global(button:hover) > .wordmark .red { transform: translateY(-0.1em) rotate(-34deg); }
  :global(a:hover) > .wordmark .blue, :global(button:hover) > .wordmark .blue { transform: translateY(-0.1em) rotate(2deg); transition-delay: 0.06s; }
</style>
