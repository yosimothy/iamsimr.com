---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index = 0 } = Astro.props;
const { title, summary, stack, link, repo, role } = project.data;
// Rotate through the three marker colours, and tilt each page slightly differently.
const colors = ['c-red', 'c-blue', 'c-yellow'];
const tilts = ['-0.6deg', '0.5deg', '-0.3deg', '0.7deg'];
---
<article class={`card taped ${colors[index % 3]}`} style={`--rot:${tilts[index % 4]}; --tilt:${index % 2 ? '4deg' : '-3deg'}`}>
  {role && <p class="role">{role}</p>}
  <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
  <p class="muted">{summary}</p>
  <div>{stack.map((s) => <span class="tag">{s}</span>)}</div>
  <p class="links">
    <a href={`/projects/${project.id}/`}>Read the write-up</a>
    {link && <a href={link}>Live ↗</a>}
    {repo && <a href={repo}>Code ↗</a>}
  </p>
</article>
<style>
  article { display: flex; flex-direction: column; transform: rotate(var(--rot)); transition: transform 0.25s ease, box-shadow 0.25s ease; }
  article:hover { transform: rotate(0deg) translateY(-4px); box-shadow: 0 2px 4px rgb(20 20 20 / 6%), 0 18px 34px -10px rgb(20 20 20 / 22%); }
  .role { font: 400 1.4rem/1 var(--hand); color: var(--accent); margin-bottom: 0.4rem; }
  .c-yellow .role { color: var(--ink-2); }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--ink); text-decoration: underline 3px var(--accent); text-underline-offset: 4px; }
  .links { display: flex; gap: 1rem; flex-wrap: wrap; margin: auto 0 0; padding-top: 0.6rem; font-size: 0.92rem; font-weight: 600; }
</style>
