---
import { SITE } from '../site.config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer>
  <svg class="squiggle" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 22 C 120 4, 220 36, 360 20 S 600 6, 760 22 S 1020 34, 1200 16" fill="none" stroke="var(--blue)" stroke-width="3" stroke-linecap="round" />
    <path d="M0 28 C 160 14, 260 38, 420 26 S 700 12, 860 28 S 1080 36, 1200 24" fill="none" stroke="var(--yellow)" stroke-width="3" stroke-linecap="round" opacity="0.9" />
    <path d="M0 16 C 140 30, 300 8, 480 18 S 760 30, 940 14 S 1120 10, 1200 20" fill="none" stroke="var(--red)" stroke-width="2.2" stroke-linecap="round" opacity="0.8" />
  </svg>
  <div class="wrap inner">
    <div>
      <p class="sign">
        <!-- Easter egg: the logo is a light switch. -->
        <button class="lamp" type="button" aria-label="Switch between light and dark mode"><Logo size="1.35rem" /></button>
        <span class="lamp-note hand" aria-live="polite"></span>
      </p>
      <p class="muted">Built with Astro, hosted on AWS. <a href="/projects/this-website/">Here's how</a>.</p>
      <p class="hand muted">thanks for reading <span class="peace-hand" role="img" aria-label="peace sign">✌️</span></p>
    </div>
    <ul>
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      {SITE.socials.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
  <p class="wrap muted small">© {year} {SITE.name}</p>
</footer>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.lamp');
  const note = document.querySelector<HTMLElement>('.lamp-note');
  let t: number | undefined;
  btn?.addEventListener('click', () => {
    const next = (window as any).__flipTheme?.();
    if (!note || !next) return;
    note.textContent = next === 'dark' ? 'lights off 🌙' : 'lights on ☀️';
    note.classList.add('show');
    clearTimeout(t);
    t = window.setTimeout(() => note.classList.remove('show'), 1800);
  });
</script>
<style>
  footer { margin-top: 4rem; padding-bottom: 1.5rem; font-size: 0.95rem; }
  .squiggle { display: block; width: 100%; height: 40px; margin-bottom: 2rem; }
  .inner { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .sign { display: flex; align-items: center; gap: 0.5rem; font: 800 1.25rem/1 var(--display); margin-bottom: 0.7rem; }
  .hand { font-size: 1.4rem; margin: 0; }
  .lamp { all: unset; display: inline-flex; cursor: default; border-radius: 50%; transition: transform 0.3s ease; }
  .lamp:active { transform: scale(0.96); }
  .lamp:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  .lamp-note { font: 400 1.35rem/1 var(--hand); color: var(--red); opacity: 0; transform: translateY(4px); transition: opacity 0.3s ease, transform 0.3s ease; }
  .lamp-note.show { opacity: 1; transform: none; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .small { font-size: 0.85rem; margin-top: 1.5rem; }
</style>
