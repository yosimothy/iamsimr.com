---
/*
  "Lately": a small bullet-journal log in the home page hero, plus what Sim is
  reading, listening to, playing and watching. Edited in Sanity Studio → Profile →
  Lately (home page). The lists below are only used until those fields are filled in.
*/
import { getProfile, type Profile } from '../lib/sanity';

const profile = await getProfile();

const FALLBACK_LOG = [
  { kind: 'learning', verb: 'learning', text: 'how AWS actually hands you this page' },
  { kind: 'tinkering', verb: 'tinkering', text: 'with the look of this notebook' },
  { kind: 'shipped', verb: 'shipped', text: 'this website' },
];
const FALLBACK_MEDIA: NonNullable<Profile['onRotation']> = [
  { kind: 'reading', title: 'The Autobiography of Malcolm X', by: 'Malcolm X & Alex Haley' },
  { kind: 'reading', title: 'Project Hail Mary', by: 'Andy Weir' },
  { kind: 'listening', title: 'The Fall Off', by: 'J. Cole' },
  { kind: 'playing', title: 'GTA VI', note: '// Just started Chapter 3' },
];
const BULLET: Record<string, string> = { learning: '•', tinkering: '○', next: '>', shipped: '✓' };

const items = profile.lately?.length ? profile.lately : FALLBACK_LOG;
const media = profile.onRotation?.length ? profile.onRotation : FALLBACK_MEDIA;
// One label per kind, in a fixed order, with that kind's items under it.
const groups = (['reading', 'listening', 'playing', 'watching'] as const)
  .map((kind) => ({ kind, list: media.filter((m) => m.kind === kind) }))
  .filter((g) => g.list.length);
const updated = profile.latelyUpdated
  ? new Date(profile.latelyUpdated + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })
  : undefined;
---
<aside class="lately" aria-labelledby="lately-h">
  <!-- A hand-drawn marker line between the hero and this log (wide screens only). -->
  <svg class="divider" viewBox="0 0 12 400" preserveAspectRatio="none" aria-hidden="true">
    <path d="M7 3 C 3.5 45, 9.5 90, 6 140 S 2.8 220, 7.6 268 S 4 345, 6.4 396" vector-effect="non-scaling-stroke" />
    <path class="pass" d="M6.2 30 C 8.6 90, 4.2 150, 6.8 210 S 8.4 300, 5.6 360" vector-effect="non-scaling-stroke" />
  </svg>
  <h2 id="lately-h" class="hand">lately</h2>
  <ul class="log">
    {items.map((i) => (
      <li class={`k-${i.kind ?? 'learning'}`}>
        <i aria-hidden="true">{BULLET[i.kind ?? 'learning'] ?? '•'}</i>
        <span><b>{i.verb}</b> {i.text}</span>
      </li>
    ))}
  </ul>
  {groups.length > 0 && (
    <>
      <h3 class="hand rot">on rotation</h3>
      <dl class="media">
        {groups.map((g) => (
          <div class={`m-${g.kind}`}>
            <dt class="hand">{g.kind}</dt>
            {g.list.map((m) => (
              <dd>
                {m.link ? <a href={m.link} rel="noopener">{m.title}</a> : <span class="t">{m.title}</span>}
                {m.by && <span class="by"> · {m.by}</span>}
                {m.note && <span class="note hand"> {m.note}</span>}
              </dd>
            ))}
          </div>
        ))}
      </dl>
    </>
  )}
  {updated && <p class="upd hand">updated {updated}</p>}
</aside>
<style>
  .lately { position: relative; padding: 0.5rem 0 0.5rem clamp(0rem, 3vw, 2.5rem); max-width: 30rem; }
  /* Sits in the middle of the hero's column gap and runs the height of the log. */
  .divider { position: absolute; top: 0.4rem; bottom: 0; left: calc(clamp(2rem, 6vw, 4.5rem) / -2 - 6px); width: 12px; height: auto; overflow: visible; pointer-events: none; }
  .divider path { fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; opacity: 0.5; }
  .divider .pass { stroke-width: 1.3; opacity: 0.22; } /* a lighter second pass, like a re-traced marker line */
  h2 { font-size: 2rem; font-weight: 400; color: var(--red); margin: 0 0 0.7rem; letter-spacing: 0; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .log li { display: flex; gap: 0.9rem; align-items: baseline; font-size: 1.12rem; line-height: 1.45; color: var(--ink-2); }
  .log b { font-weight: 650; color: var(--ink); }
  .log i { font: 700 1.2rem/1 var(--display); font-style: normal; flex: 0 0 1rem; text-align: center; color: var(--ink); }
  .k-learning i { color: var(--blue); } .k-tinkering i { color: var(--red); } .k-next i { color: var(--yellow); }

  .rot { font-size: 1.35rem; font-weight: 400; color: var(--ink-2); margin: 1.8rem 0 0.5rem; letter-spacing: 0; }
  .media { margin: 0; display: grid; gap: 0.6rem; }
  .media div { display: grid; grid-template-columns: 6.4rem 1fr; align-items: baseline; column-gap: 0.6rem; row-gap: 0.2rem; }
  .media dt { font-size: 1.45rem; line-height: 1; color: var(--c); grid-row: span 4; }
  .media dd { grid-column: 2; margin: 0; font-size: 1.02rem; color: var(--ink-2); min-width: 0; }
  .media .t, .media a { font-weight: 600; color: var(--ink); }
  .media a { text-decoration: none; background: linear-gradient(var(--c), var(--c)) no-repeat 0 100% / 100% 2px; }
  .media a:hover { background-size: 100% 0.5em; }
  .media .note { font-size: 1.3rem; color: var(--c); white-space: nowrap; }
  .m-reading { --c: var(--blue); } .m-listening { --c: var(--red); }
  .m-playing { --c: color-mix(in srgb, var(--yellow) 80%, var(--ink)); }
  .m-watching { --c: var(--ink-2); }

  .upd { font-size: 1.25rem; color: var(--ink-2); opacity: 0.75; margin: 1.4rem 0 0; }
  @media (max-width: 860px) {
    .lately { padding-left: 0; }
    .divider { display: none; }
  }
</style>
