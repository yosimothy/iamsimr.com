---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Things I've built and what I learned building them.">
  <section class="wrap">
    <p class="eyebrow">on the desk</p>
    <h1><span class="scribble">Projects</span></h1>
    <p class="muted lede">A mix of client work, side projects and experiments. Each one has a short write-up of the problem, the approach, and what I'd do differently.</p>
    <div class="grid desk">{projects.map((project, i) => <ProjectCard project={project} index={i} />)}</div>
  </section>
</Base>
<style>section { position: relative; } h1, .lede, .grid { position: relative; z-index: 1; }.lede { font-size: 1.15rem; max-width: 56ch; margin-bottom: 3rem; }</style>
