---
/*
  One note. Laid out to be easy to read and easy to skim:
  a big title and one-line summary, the photo, a sticky note with the short
  version, then short sections in large, comfortable type.
*/
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';
import { imageUrl } from '../../lib/sanity';
import { SITE } from '../../site.config';

// At build time Astro calls this once and writes one HTML page per post.
export async function getStaticPaths() {
  const posts = await getPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags, cover, keyPoints } = post.data;
// Sanity images can be resized on the fly; local images are used as they are.
// The whole photo, never cropped: only the width is set.
const coverSrc = cover && (/^https?:/.test(cover.url) ? imageUrl(cover as any, 900) : cover.url);
---
<Base title={title} description={description} type="article">
  <article>
    <header class:list={['wrap head', { 'has-cover': cover }]}>
      <div class="intro">
        <p class="when">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span> {readingTime(post.body)}
        </p>
        <h1>{title}</h1>
        <p class="dek">{description}</p>
        {keyPoints.length > 0 && (
          <aside class="glance" aria-label="The short version">
            <p class="glance-label">the short version</p>
            <ul>{keyPoints.map((k) => <li>{k}</li>)}</ul>
          </aside>
        )}
      </div>
      {cover && (
        /* A print taped into the notebook: the whole photo, uncropped. */
        <figure class="cover polaroid">
          <img src={coverSrc} alt={cover.alt ?? ''} fetchpriority="high" />
          {cover.caption && <figcaption>{cover.caption}</figcaption>}
        </figure>
      )}
    </header>

    <div class="wrap">
      <div class="prose note flow"><Content /></div>
    </div>

    <div class="wrap tail">

      {tags.length > 0 && <p class="tags">{tags.map((t) => <span class="tag">#{t}</span>)}</p>}

      {(newer || older) && (
        <nav class="pager" aria-label="More notes">
          {older ? (
            <a class="older" href={`/blog/${older.id}/`}><span class="dir">← older</span><span class="t">{older.data.title}</span></a>
          ) : <span />}
          {newer && (
            <a class="newer" href={`/blog/${newer.id}/`}><span class="dir">newer →</span><span class="t">{newer.data.title}</span></a>
          )}
        </nav>
      )}

      <aside class="card taped c-yellow thanks">
        <p><strong>Thanks for reading.</strong> If this was useful, or you'd like help with a project of your own, email me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
        <a href="/blog/">← all notes</a>
      </aside>
    </div>
  </article>
</Base>
<style>
  article { padding-block: clamp(2rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem); }
  /* Tags, older/newer and the thank-you sit under the text column. */
  .tail > * { max-width: 44rem; }

  .head { display: grid; gap: clamp(1.5rem, 5vw, 4.5rem); align-items: start; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .head.has-cover { grid-template-columns: minmax(0, 44rem) minmax(0, 1fr); }
  .head.has-cover .polaroid { justify-self: center; }
  .head:not(.has-cover) .intro { max-width: 44rem; }
  @media (max-width: 860px) { .head.has-cover { grid-template-columns: 1fr; } }
  .when { font: 400 1.5rem/1 var(--hand); color: var(--red); margin: 0 0 0.9rem; display: inline-block; transform: rotate(-1.5deg); }
  .when span { margin: 0 0.15em; }
  h1 { font-size: clamp(2.3rem, 6.2vw, 3.9rem); line-height: 1.02; margin-bottom: 0.4em; text-wrap: balance; }
  .dek { font-size: clamp(1.15rem, 2.2vw, 1.35rem); line-height: 1.5; color: var(--ink-2); margin: 0; text-wrap: pretty; }

  /* The photo is a print taped into the notebook, like the one on About. */
  .polaroid { position: relative; margin: 0.5rem auto 0; width: min(100%, 24rem); background: #fff; padding: 12px 12px 0; border-radius: 3px; box-shadow: 0 1px 2px rgb(0 0 0 / 8%), 0 14px 30px -10px rgb(0 0 0 / 28%); transform: rotate(2deg); }
  .polaroid::before { content: ''; position: absolute; top: -12px; left: 50%; width: 92px; height: 26px; margin-left: -46px; background: rgb(255 241 191 / 0.75); transform: rotate(-3deg); border-radius: 2px; box-shadow: 0 1px 2px rgb(0 0 0 / 8%); }
  .polaroid img { display: block; width: 100%; height: auto; border-radius: 1px; }
  .polaroid figcaption { font: 400 1.4rem/1.2 var(--hand); color: #333; text-align: center; margin: 0.55rem 0 0.7rem; }
  @media (max-width: 860px) { .polaroid { width: min(85%, 20rem); } }

  /* The short version: a flat yellow sticky. */
  .glance {
    background: var(--sticky-y); color: #141414;
    border-radius: 14px; box-shadow: var(--shadow-soft);
    padding: 1.1rem 1.4rem 1rem; margin: 0 0 clamp(2rem, 5vw, 2.75rem);
    transform: rotate(-0.5deg);
  }
  .glance-label { font: 400 1.5rem/1 var(--hand); color: #c4261b; margin: 0 0 0.55rem; }
  .glance ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .glance li { position: relative; padding-left: 1.4rem; font-size: 1.06rem; line-height: 1.45; font-weight: 500; }
  .glance li::before { content: ''; position: absolute; left: 0.2rem; top: 0.55em; width: 8px; height: 8px; border-radius: 50%; background: #141414; }

  /* Body copy: bigger type, more air, short paragraphs breathe. */
  .note { font-size: clamp(1.1rem, 1.6vw, 1.2rem); line-height: 1.75; }
  .note :global(p) { margin-bottom: 1.3em; }
  .note > :global(p:first-child) { font-size: 1.12em; line-height: 1.65; color: var(--ink); }
  /* Section headings are signposts for skimmers: a red bullet, then the words. */
  .note :global(h2) { font-size: clamp(1.45rem, 2.6vw, 1.75rem); margin: 2.4em 0 0.6em; line-height: 1.15; }
  .note :global(h2::before) { content: ''; display: inline-block; width: 0.42em; height: 0.42em; border-radius: 50%; background: var(--red); margin-right: 0.45em; vertical-align: 0.12em; }
  .note :global(h3) { font-size: 1.2rem; margin: 1.9em 0 0.5em; }
  .note :global(blockquote) { margin: 1.8em 0; font-size: 1.75em; line-height: 1.2; border-left-width: 6px; border-radius: 3px; padding: 0.15em 0 0.2em 0.9em; }
  .note :global(blockquote p) { margin: 0; }
  .note :global(figure), .note :global(img) { margin-block: 2em; }

  .tags { margin: 2.5rem 0 0; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; }
  .pager a { display: grid; gap: 0.25rem; padding: 1rem 1.1rem; border-radius: 14px; background: var(--paper); box-shadow: var(--shadow-soft); text-decoration: none; transition: transform 0.18s ease; }
  .pager a:hover { color: var(--ink); transform: translateY(-2px); }
  .pager .newer { text-align: right; grid-column: 2; }
  .dir { font: 400 1.3rem/1 var(--hand); color: var(--blue); }
  .t { font: 700 1.05rem/1.25 var(--display); letter-spacing: -0.01em; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .newer { grid-column: 1; } }

  .thanks { margin-top: 3rem; }
</style>
